# Copy to backend/.env and fill in. NEVER commit backend/.env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

POSTGRES_DB=electava_core
POSTGRES_USER=electava
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

AUTH_THROTTLE_RATE=10/min
MAX_UPLOAD_SIZE_MB=25

# Password for development seed users (seed_dev_data). Leave empty to auto-generate and print.
DEV_SEED_PASSWORD=

# Production object storage (S3-compatible: AWS S3, MinIO, Cloudflare R2, ...)
USE_S3=false
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
